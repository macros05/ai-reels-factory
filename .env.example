ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# VIDEO_PROVIDER: which Higgsfield model generates the visuals.
#   seedance → Seedance 2.0       (5×5s clips, ElevenLabs lip-sync inline, ~50 cr/reel) — default
#   kling    → Kling v3.0         (5×5s clips, ElevenLabs lip-sync inline, ~250 cr/reel)
#   veo      → Veo 3.1            (3×8s clips, NATIVE audio, ElevenLabs skipped, ~1200 cr/reel)
VIDEO_PROVIDER=seedance

# Higgsfield is wired via the official CLI (browser device-flow auth), not an
# API key. Run `higgsfield auth login` once on the host; the token lives at
# ~/.higgsfield. See docs/HIGGSFIELD_API.md for the full setup.
# Override the binary path here only if it lives outside $PATH.
# HF_CLI_PATH=higgsfield

# Higgsfield model_ids (CLI job_set_type strings). Defaults track the latest
# known good revisions as of 2026-05; override if Higgsfield ships a new one.
# Verify with `higgsfield model list` on the host.
# HF_VEO_MODEL=veo3_1
# HF_KLING_MODEL=kling3_0
# HF_SEEDANCE_MODEL=seedance_2_0
# HF_SOUL_IMAGE_MODEL=text2image_soul_v2

# Per-provider quality knobs (overridable).
# HF_KLING_MODE=pro            # pro | std | 4k
# HF_SEEDANCE_MODE=std         # std | fast
# HF_SEEDANCE_RESOLUTION=1080p # 480p | 720p | 1080p
# HF_VEO_VARIANT=veo-3-1-fast  # veo-3-1-preview | veo-3-1-fast
# HF_VEO_QUALITY=basic         # basic | high | ultra

# Único password de acceso, cámbialo
APP_PASSWORD=

# Secreto para firmar JWTs. Genera uno con: openssl rand -hex 32
JWT_SECRET=
